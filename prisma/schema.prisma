generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFO
  READY_FOR_SUPPLIER_RFQ
  QUOTED
  PURCHASED
  CLOSED
}

enum OperatorCompleteness {
  READY_FOR_REVIEW
  MISSING_INFO
  COMPLETE
}

enum RequestOrigin {
  ACCOUNT
  GUEST_SIMPLE_QUOTE
}

enum SupplierOrderStatus {
  AWAITING_ACKNOWLEDGMENT
  IN_PRODUCTION
  QC_IN_PROGRESS
  DOCUMENTS_UPLOADED
  READY_TO_SHIP
  SHIPPED
}

enum SupplierDocumentCategory {
  INSPECTION_REPORT
  MATERIAL_CERT
  CERTIFICATE_OF_CONFORMANCE
  PHOTO
  PACKING_SLIP
  OTHER
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model Company {
  id                  String    @id @default(cuid())
  customerId          String?   @unique
  name                String
  website             String    @default("")
  industry            String    @default("")
  primaryContactName  String    @default("")
  primaryContactEmail String    @default("")
  billingEmail        String    @default("")
  customerTier        String    @default("Standard")
  accountStatus       String    @default("Active")
  notes               String    @default("")
  users               User[]
  requests            Request[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model CustomerSequence {
  key       String   @id
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaitingListEntry {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  company          String
  procurementNeeds String
  joinedAt         DateTime @default(now())
}

model AccountDefaults {
  id                         String   @id
  name                       String   @default("")
  email                      String   @default("")
  phone                      String   @default("")
  companyName                String   @default("")
  passwordChangedAt          String   @default("")
  mfaEnabled                 Boolean  @default(true)
  shippingName               String   @default("")
  shippingCompany            String   @default("")
  shippingAddress1           String   @default("")
  shippingAddress2           String   @default("")
  shippingCity               String   @default("")
  shippingState              String   @default("")
  shippingZipCode            String   @default("")
  billingName                String   @default("")
  billingCompany             String   @default("")
  billingAddress1            String   @default("")
  billingAddress2            String   @default("")
  billingCity                String   @default("")
  billingState               String   @default("")
  billingZipCode             String   @default("")
  billingEmail               String   @default("")
  billingInvoiceRoutingNotes String   @default("")
  stripeCustomerId           String   @default("")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Request {
  id                              String                           @id @default(cuid())
  title                           String
  process                         String
  dueDate                         DateTime?
  status                          RequestStatus                    @default(DRAFT)
  requestOrigin                   RequestOrigin                     @default(ACCOUNT)
  guestAccessTokenHash            String                           @default("")
  guestAccessTokenExpiresAt       DateTime?
  buyerCompanyId                  String?
  buyerCompany                    Company?                         @relation(fields: [buyerCompanyId], references: [id])
  requesterName                   String
  requesterEmail                  String                           @default("")
  requesterPhone                  String                           @default("")
  shipToName                      String                           @default("")
  shipToCompany                   String                           @default("")
  shipToAddress1                  String                           @default("")
  shipToAddress2                  String                           @default("")
  shipToCity                      String                           @default("")
  shipToState                     String                           @default("")
  shipToZipCode                   String                           @default("")
  shipToPhone                     String                           @default("")
  operatorCompleteness            OperatorCompleteness             @default(READY_FOR_REVIEW)
  assignedOwner                   String?
  internalNotes                   String                           @default("")
  supplierPackageNotes            String                           @default("")
  supplierOrderStatus             SupplierOrderStatus              @default(AWAITING_ACKNOWLEDGMENT)
  supplierShopName                String                           @default("China supplier team")
  supplierContactName             String                           @default("")
  supplierNotes                   String                           @default("")
  supplierTrackingNumber          String                           @default("")
  estimatedPriceCents             Int?
  leadTimeDays                    Int?
  shippingCostCents               Int?
  shippingMethod                  String                           @default("")
  shippingTerms                   String                           @default("")
  estimatedDeliveryDate           DateTime?
  quoteCreatedDate                DateTime?
  quoteValidUntil                 DateTime?
  quoteSummary                    String                           @default("")
  purchasePaymentMethod           String                           @default("")
  purchasePaymentStatus           String                           @default("")
  customerPoNumber                String                           @default("")
  accountsPayableEmail            String                           @default("")
  buyerCheckoutNotes              String                           @default("")
  purchaseCardId                  String                           @default("")
  purchaseCardBrand               String                           @default("")
  purchaseCardLast4               String                           @default("")
  purchaseCardHolder              String                           @default("")
  purchaseCardExpires             String                           @default("")
  stripeCheckoutSessionId         String                           @default("")
  stripePaymentIntentId           String                           @default("")
  stripeAmountCents               Int?
  stripeCurrency                  String                           @default("")
  stripePaidAt                    DateTime?
  isArchived                      Boolean                          @default(false)
  revisionOfRequestId             String?
  revisionNumber                  Int                              @default(1)
  revisionChangeLog               String[]                         @default([])
  lineItems                       RequestLineItem[]
  files                           UploadedFile[]
  supplierQuoteFiles              SupplierQuoteAttachment[]
  supplierDocuments               SupplierDocument[]
  supplierUpdates                 SupplierUpdate[]
  supplierQuotes                  SupplierQuote[]
  customerPurchaseOrderAttachment CustomerPurchaseOrderAttachment?
  customerQuotes                  CustomerQuoteVersion[]
  invoices                        Invoice[]
  statusEvents                    StatusEvent[]
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
}

model CustomerPurchaseOrderAttachment {
  id         String   @id @default(cuid())
  requestId  String   @unique
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name       String
  sizeBytes  Int
  type       String
  storageKey String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model InvoiceSequence {
  year      Int      @id
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique
  sequenceYear      Int
  sequenceValue     Int
  status            InvoiceStatus @default(ISSUED)
  requestId         String?
  request           Request?      @relation(fields: [requestId], references: [id], onDelete: SetNull)
  customerCompany   String        @default("")
  customerContact   String        @default("")
  customerPo        String        @default("")
  quoteNumber       String        @default("")
  paymentTerms      String        @default("100% Payment in Advance")
  shippingTerms     String        @default("")
  subtotalCents     Int           @default(0)
  shippingCents     Int           @default(0)
  salesTaxCents     Int           @default(0)
  amountPaidCents   Int           @default(0)
  amountDueCents    Int           @default(0)
  issuedAt          DateTime      @default(now())
  dueDate           DateTime?
  billToSnapshot    Json?
  shipToSnapshot    Json?
  lineItemsSnapshot Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([sequenceYear, sequenceValue])
  @@index([requestId, issuedAt])
}

model CustomerQuoteVersion {
  id              String    @id @default(cuid())
  requestId       String
  request         Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  versionNumber   Int
  quoteNumber     String
  quoteDate       DateTime?
  validUntil      DateTime?
  preparedBy      String    @default("Lattice")
  customerCompany String
  customerContact String
  projectName     String
  leadTime        String    @default("")
  shipping        String    @default("")
  tax             String    @default("")
  notes           String    @default("")
  assumptions     String    @default("")
  clarifications  String    @default("")
  filesReviewed   String    @default("")
  lineItems       Json
  totalCents      Int
  markdown        String
  issuedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([requestId, versionNumber])
  @@index([requestId, issuedAt])
}

enum SupplierQuoteStatus {
  INVITED
  QUOTE_RECEIVED
  DECLINED
  SELECTED
}

model SupplierQuote {
  id           String              @id @default(cuid())
  requestId    String
  request      Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shopName     String
  country      String              @default("China")
  contactName  String              @default("")
  status       SupplierQuoteStatus @default(INVITED)
  priceCents   Int?
  leadTimeDays Int?
  notes        String              @default("")
  lineItems    Json?
  quotedAt     DateTime?
  isSelected   Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model SupplierQuoteAttachment {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name       String
  sizeBytes  Int
  type       String
  storageKey String?
  createdAt  DateTime @default(now())

  @@index([requestId, createdAt])
}

model RequestLineItem {
  id                   String   @id @default(cuid())
  requestId            String
  request              Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partName             String
  quantity             Int
  material             String
  generalTolerance     String   @default("")
  surfaceFinish        String   @default("")
  qualityDocumentation String[] @default([])
  notes                String   @default("")
  createdAt            DateTime @default(now())
}

model UploadedFile {
  id            String   @id @default(cuid())
  requestId     String
  request       Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name          String
  sizeBytes     Int
  type          String
  storageKey    String?
  cadPreviewUrn String?
  createdAt     DateTime @default(now())
}

model SupplierDocument {
  id        String                   @id @default(cuid())
  requestId String
  request   Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  sizeBytes Int
  type      String
  category  SupplierDocumentCategory @default(OTHER)
  createdAt DateTime                 @default(now())
}

model SupplierUpdate {
  id             String              @id @default(cuid())
  requestId      String
  request        Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status         SupplierOrderStatus
  note           String              @default("")
  trackingNumber String              @default("")
  createdAt      DateTime            @default(now())
}

model StatusEvent {
  id        String         @id @default(cuid())
  requestId String
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from      RequestStatus?
  to        RequestStatus
  actor     String
  createdAt DateTime       @default(now())
}
