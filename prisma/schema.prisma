generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFO
  READY_FOR_SUPPLIER_RFQ
  QUOTED
  PURCHASED
  CLOSED
}

enum OperatorCompleteness {
  READY_FOR_REVIEW
  MISSING_INFO
  COMPLETE
}

enum SupplierOrderStatus {
  AWAITING_ACKNOWLEDGMENT
  IN_PRODUCTION
  QC_IN_PROGRESS
  DOCUMENTS_UPLOADED
  READY_TO_SHIP
  SHIPPED
}

enum SupplierDocumentCategory {
  INSPECTION_REPORT
  MATERIAL_CERT
  CERTIFICATE_OF_CONFORMANCE
  PHOTO
  PACKING_SLIP
  OTHER
}

model Company {
  id                  String    @id @default(cuid())
  name                String
  website             String    @default("")
  industry            String    @default("")
  primaryContactName  String    @default("")
  primaryContactEmail String    @default("")
  billingEmail        String    @default("")
  customerTier        String    @default("Standard")
  accountStatus       String    @default("Active")
  notes               String    @default("")
  users               User[]
  requests            Request[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaitingListEntry {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  company          String
  procurementNeeds String
  joinedAt         DateTime @default(now())
}

model Request {
  id                     String                 @id @default(cuid())
  title                  String
  process                String
  dueDate                DateTime?
  status                 RequestStatus          @default(DRAFT)
  buyerCompanyId         String?
  buyerCompany           Company?               @relation(fields: [buyerCompanyId], references: [id])
  requesterName          String
  operatorCompleteness   OperatorCompleteness   @default(READY_FOR_REVIEW)
  assignedOwner          String?
  internalNotes          String                 @default("")
  supplierPackageNotes   String                 @default("")
  supplierOrderStatus    SupplierOrderStatus    @default(AWAITING_ACKNOWLEDGMENT)
  supplierShopName       String                 @default("China supplier team")
  supplierContactName    String                 @default("")
  supplierNotes          String                 @default("")
  supplierTrackingNumber String                 @default("")
  estimatedPriceCents    Int?
  leadTimeDays           Int?
  shippingCostCents      Int?
  shippingMethod         String                 @default("")
  shippingTerms          String                 @default("")
  estimatedDeliveryDate  DateTime?
  quoteCreatedDate       DateTime?
  quoteValidUntil        DateTime?
  quoteSummary           String                 @default("")
  lineItems              RequestLineItem[]
  files                  UploadedFile[]
  supplierDocuments      SupplierDocument[]
  supplierUpdates        SupplierUpdate[]
  supplierQuotes         SupplierQuote[]
  customerQuotes         CustomerQuoteVersion[]
  statusEvents           StatusEvent[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model CustomerQuoteVersion {
  id              String    @id @default(cuid())
  requestId       String
  request         Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  versionNumber   Int
  quoteNumber     String
  quoteDate       DateTime?
  validUntil      DateTime?
  preparedBy      String    @default("Lattice")
  customerCompany String
  customerContact String
  projectName     String
  leadTime        String    @default("")
  shipping        String    @default("")
  tax             String    @default("")
  notes           String    @default("")
  assumptions     String    @default("")
  clarifications  String    @default("")
  filesReviewed   String    @default("")
  lineItems       Json
  totalCents      Int
  markdown        String
  issuedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([requestId, versionNumber])
  @@index([requestId, issuedAt])
}

enum SupplierQuoteStatus {
  INVITED
  QUOTE_RECEIVED
  DECLINED
  SELECTED
}

model SupplierQuote {
  id           String              @id @default(cuid())
  requestId    String
  request      Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  shopName     String
  country      String              @default("China")
  contactName  String              @default("")
  status       SupplierQuoteStatus @default(INVITED)
  priceCents   Int?
  leadTimeDays Int?
  notes        String              @default("")
  quotedAt     DateTime?
  isSelected   Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model RequestLineItem {
  id                   String   @id @default(cuid())
  requestId            String
  request              Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  partName             String
  quantity             Int
  material             String
  generalTolerance     String   @default("")
  surfaceFinish        String   @default("")
  qualityDocumentation String[] @default([])
  notes                String   @default("")
  createdAt            DateTime @default(now())
}

model UploadedFile {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name       String
  sizeBytes  Int
  type       String
  storageKey String?
  createdAt  DateTime @default(now())
}

model SupplierDocument {
  id        String                   @id @default(cuid())
  requestId String
  request   Request                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  sizeBytes Int
  type      String
  category  SupplierDocumentCategory @default(OTHER)
  createdAt DateTime                 @default(now())
}

model SupplierUpdate {
  id             String              @id @default(cuid())
  requestId      String
  request        Request             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status         SupplierOrderStatus
  note           String              @default("")
  trackingNumber String              @default("")
  createdAt      DateTime            @default(now())
}

model StatusEvent {
  id        String         @id @default(cuid())
  requestId String
  request   Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from      RequestStatus?
  to        RequestStatus
  actor     String
  createdAt DateTime       @default(now())
}
