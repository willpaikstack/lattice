# Copy to .env.local for local development. Do not commit real secrets.
DATABASE_URL="postgresql://lattice:lattice@localhost:5432/lattice_os?schema=public"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="lattice-os-dev"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
AUTH_SECRET="replace-me"

# Google Workspace SSO (OAuth 2.0 / OpenID Connect).
# Create a Google OAuth web client and add this redirect URI:
# http://localhost:3000/api/auth/google/callback
GOOGLE_SSO_CLIENT_ID="replace-me"
GOOGLE_SSO_CLIENT_SECRET="replace-me"
GOOGLE_SSO_ALLOWED_DOMAINS="your-company.com"
GOOGLE_SSO_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Optional transactional email for waiting list thank-you messages.
# Without RESEND_API_KEY, thank-you emails are recorded in .data/email-outbox.json locally.
RESEND_API_KEY=""
WAITLIST_EMAIL_FROM="Lattice <hello@latticeos.com>"
WAITLIST_EMAIL_APP_NAME="Lattice"

# Autodesk Platform Services CAD preview translation.
# Create an APS app, copy the Client ID/Secret into .env.local, and restart the dev server.
# Never commit real APS secrets. If a secret is pasted into chat or logs, regenerate it in Autodesk.
# Bucket keys must be globally unique, lowercase, and can contain letters, numbers, and hyphens.
APS_CLIENT_ID="replace-me"
APS_CLIENT_SECRET="replace-me"
APS_BUCKET_KEY="replace-with-globally-unique-lowercase-bucket"
